<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sniper.game.wordgame.mapper.GameRewardConfigMapper">

    <resultMap id="RewardCandidateMap" type="com.sniper.game.wordgame.dto.RewardCandidate">
        <result column="item_type" property="itemType"
                typeHandler="com.sniper.game.wordgame.typehandler.ItemTypeEnumTypeHandler"/>
        <result column="resource_code" property="resourceCode"
                typeHandler="com.sniper.game.wordgame.typehandler.ResourceCodeHandler"/>
        <result column="collect_code" property="collectCode"/>
        <result column="amount" property="amount"/>
        <result column="image_url" property="imageUrl"/>
        <result column="weight" property="weight"/>
    </resultMap>

    <!--
      item_type=1(prop) 时 JOIN game_resource 取 resource_code；
      item_type=2(collect) 时 JOIN game_collect 取 collect_code；两分支 UNION ALL 合并。
      mode/item_type 均为 TINYINT 枚举 code：mode 走 GameRewardModeEnumTypeHandler 绑参，item_type 字面量按 code 硬编码。
    -->
    <sql id="candidateUnion">
        select c.item_type, res.resource_code, null as collect_code, c.amount, res.url as image_url, c.weight
        from game_reward_config c
                 join game_resource res on c.item_id = res.id
        where c.mode = #{mode, typeHandler=com.sniper.game.wordgame.typehandler.GameRewardModeEnumTypeHandler}
          and c.stage = #{stage} and c.item_type = 1
        union all
        select c.item_type, null as resource_code, gc.collect_code, c.amount, gc.color_url as image_url, c.weight
        from game_reward_config c
                 join game_collect gc on c.item_id = gc.id
        where c.mode = #{mode, typeHandler=com.sniper.game.wordgame.typehandler.GameRewardModeEnumTypeHandler}
          and c.stage = #{stage} and c.item_type = 2
    </sql>

    <select id="findFixedReward" resultMap="RewardCandidateMap">
        <include refid="candidateUnion"/>
        limit 1
    </select>

    <select id="findCandidates" resultMap="RewardCandidateMap">
        <include refid="candidateUnion"/>
    </select>
</mapper>
