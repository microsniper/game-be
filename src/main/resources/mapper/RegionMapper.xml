<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sniper.game.wordgame.mapper.RegionMapper">

    <resultMap id="RegionResultMap" type="com.sniper.game.wordgame.entity.Region">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="code" property="code"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="enabled" property="enabled"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="findAllEnabled" resultMap="RegionResultMap">
        select id, name, code, sort_order, enabled, created_at
        from `region`
        where enabled = 1
        order by sort_order asc, id asc
    </select>

    <select id="countEnabledById" resultType="int">
        select count(1) from `region` where id = #{id} and enabled = 1
    </select>
</mapper>
